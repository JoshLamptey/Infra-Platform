# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Used to write grades and
# to run the seed script. NEVER prefix this with NEXT_PUBLIC_ and never
# ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Free API key from https://aistudio.google.com/apikey — no credit card
# required. Used to auto-grade open-ended quiz answers.
GEMINI_API_KEY=
ADMIN_EMAILS = 
